<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta profesional TextilCalc: claro + oscuro (#10152F family). -->
    <Color x:Key="Primary">#697CFF</Color>
    <Color x:Key="PrimaryDark">#8C5DFF</Color>
    <Color x:Key="PrimaryDarkText">#10152F</Color>
    <Color x:Key="PrimarySoft">#EEF1FF</Color>
    <Color x:Key="PrimarySoftDark">#29365C</Color>
    <Color x:Key="Secondary">#8C5DFF</Color>
    <Color x:Key="SecondaryDarkText">#D8C8FF</Color>
    <Color x:Key="Tertiary">#48355F</Color>
    <Color x:Key="AccentBlue">#697CFF</Color>
    <Color x:Key="AccentPurple">#8C5DFF</Color>

    <Color x:Key="Error">#E85D5D</Color>
    <Color x:Key="ErrorSoft">#FEECEC</Color>
    <Color x:Key="ErrorSoftDark">#3B1B2A</Color>
    <Color x:Key="Success">#2F9E7B</Color>
    <Color x:Key="SuccessSoft">#E8F8F2</Color>
    <Color x:Key="SuccessSoftDark">#16352E</Color>

    <Color x:Key="PageBackground">#F4F6FC</Color>
    <Color x:Key="PageBackgroundDark">#10152F</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#171D38</Color>
    <Color x:Key="SurfaceMuted">#EEF1F8</Color>
    <Color x:Key="SurfaceMutedDark">#252D4D</Color>
    <Color x:Key="SurfaceElevatedDark">#29365C</Color>
    <Color x:Key="SurfaceVariant">#E8ECFF</Color>
    <Color x:Key="PanelDark">#35436C</Color>
    <Color x:Key="PanelAccentDark">#48355F</Color>

    <Color x:Key="TextPrimary">#171D38</Color>
    <Color x:Key="TextSecondary">#5B6790</Color>
    <Color x:Key="TextMutedDark">#9CA9CE</Color>
    <Color x:Key="Border">#D7DDEC</Color>
    <Color x:Key="BorderDark">#35436C</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#10152F</Color>
    <Color x:Key="OffBlack">#171D38</Color>

    <Color x:Key="Gray100">#E8ECF5</Color>
    <Color x:Key="Gray200">#D0D7E8</Color>
    <Color x:Key="Gray300">#9CA9CE</Color>
    <Color x:Key="Gray400">#7B89B0</Color>
    <Color x:Key="Gray500">#5B6790</Color>
    <Color x:Key="Gray600">#35436C</Color>
    <Color x:Key="Gray900">#171D38</Color>
    <Color x:Key="Gray950">#10152F</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
