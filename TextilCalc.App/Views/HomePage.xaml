<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TextilCalc.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TextilCalc.App.ViewModels"
    x:DataType="vm:HomeViewModel"
    Title="Inicio"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <ScrollView HorizontalOptions="Fill">
        <VerticalStackLayout
            Padding="{OnIdiom Phone='18,22,18,36', Tablet='32,30,32,44', Desktop='48,38,48,52'}"
            Spacing="18"
            MaximumWidthRequest="860"
            HorizontalOptions="Fill">
            <!-- Fondo oscuro fijo: el PNG transparente usa texto blanco/dorado y debe contrastar en claro y oscuro. -->
            <Border
                BackgroundColor="{StaticResource PageBackgroundDark}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 18"
                Padding="{OnIdiom Phone='16,14', Tablet='20,16', Desktop='22,18'}">
                <Image
                    Source="vicunha_logo.png"
                    Aspect="AspectFit"
                    HeightRequest="{OnIdiom Phone=52, Tablet=64, Desktop=72}"
                    HorizontalOptions="Start"
                    SemanticProperties.Description="VICUNHA jeansidentity" />
            </Border>

            <VerticalStackLayout Spacing="6">
                <Label Text="TextilCalc" Style="{StaticResource PageTitle}" />
                <Label
                    Text="Cálculos textiles precisos y calculadora científica en un solo lugar."
                    Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <Border
                Style="{StaticResource TextilCard}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}"
                Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentPurple}}">
                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                    <Label Text="Panel de trabajo" Style="{StaticResource SectionTitle}" />
                    <Label
                        Text="Gramatura, metraje y calculadora. Entrada manual, sin catálogo."
                        Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Herramientas" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />

            <VerticalStackLayout Spacing="12">
                <!-- Botón transparente encima: en Windows TapGestureRecognizer sobre Border con Labels no recibe el clic. -->
                <Grid>
                    <Border Style="{StaticResource TextilCard}" Padding="16">
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14" InputTransparent="True">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                                <Label Text="G" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Calcular gramatura" Style="{StaticResource SectionTitle}" FontSize="16" />
                                <Label Text="Obtén la gramatura (g/m²) a partir de metraje, ancho y peso." Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                    <Button
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Command="{Binding OpenGramaturaCommand}"
                        SemanticProperties.Description="Calcular gramatura. Obtén la gramatura de una pieza." />
                </Grid>

                <Grid>
                    <Border Style="{StaticResource TextilCard}" Padding="16">
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14" InputTransparent="True">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                                <Label Text="M" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Success}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Calcular metraje" Style="{StaticResource SectionTitle}" FontSize="16" />
                                <Label Text="Convierte peso, gramatura y ancho en metros lineales disponibles." Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                    <Button
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Command="{Binding OpenMetrajeCommand}"
                        SemanticProperties.Description="Calcular metraje. Convierte peso, gramatura y ancho en metros." />
                </Grid>

                <Grid>
                    <Border Style="{StaticResource TextilCard}" Padding="16">
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14" InputTransparent="True">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                                <Label Text="∑" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Secondary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Calculadora científica" Style="{StaticResource SectionTitle}" FontSize="16" />
                                <Label Text="Funciones científicas, memoria, historial y teclado físico." Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                    <Button
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Command="{Binding OpenCalculatorCommand}"
                        SemanticProperties.Description="Calculadora científica. Operaciones básicas, avanzadas e historial." />
                </Grid>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,10,0,0">
                <Button
                    Text="{Binding ThemeLabel}"
                    Command="{Binding CycleThemeCommand}"
                    Style="{StaticResource SecondaryAction}"
                    HorizontalOptions="Start"
                    SemanticProperties.Hint="Alterna entre tema del sistema, claro y oscuro" />
                <Button
                    Grid.Column="1"
                    Text="Salir"
                    Command="{Binding ExitCommand}"
                    Style="{StaticResource DangerAction}"
                    HorizontalOptions="End"
                    SemanticProperties.Hint="Cierra TextilCalc" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
